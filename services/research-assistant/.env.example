# V13 research-assistant configuration example. Copy to .env (chmod 600).
# Real secrets must only live on the assistant server; never commit them.

ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=3230
# Container deploys: ASSISTANT_HOST=0.0.0.0 and ASSISTANT_BIND_ALL_INTERFACES=1
# only because compose publishes 127.0.0.1:3230 exclusively.

# V18 identity: selfhost (single deployment token) or account (account-service introspection).
ASSISTANT_IDENTITY_MODE=selfhost
ASSISTANT_SERVICE_TOKEN=change-me-assistant-token

# V10 content service (HTTPS required in production).
V10_BASE_URL=https://content.example.com
V10_SERVICE_TOKEN=change-me-v10-service-token
V10_PIPELINE_VERSION=v10.1

# Optional YouTube Data API key (fallback / metadata enrich only).
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

APPLE_SEARCH_BASE_URL=https://itunes.apple.com
APPLE_SEARCH_COUNTRY=US

PI_CONFIG_DIR=/var/lib/linguacast-assistant/pi
# Local: reuse the coding-agent login at ~/.pi/agent/auth.json (default).
# PI_AUTH_PATH=/Users/you/.pi/agent/auth.json
YTDLP_PATH=yt-dlp

ASSISTANT_DATABASE_PATH=/var/lib/linguacast-assistant/data/assistant.db
ASSISTANT_TEMP_ROOT=/var/lib/linguacast-assistant/tmp
ASSISTANT_MAX_BODY_BYTES=65536

ASSISTANT_YTDLP_TIMEOUT_MS=30000
ASSISTANT_YTDLP_STDOUT_MAX_BYTES=2097152
ASSISTANT_SEARCH_LIMIT=10
ASSISTANT_GLOBAL_PI_TURNS=2
ASSISTANT_GLOBAL_YTDLP=2

# Optional override. Default is prompts/systemprompt.txt next to this service.
# ASSISTANT_SYSTEM_PROMPT_PATH=/var/lib/linguacast-assistant/systemprompt.txt

# Tests / local fake only. Production must stay 0.
ASSISTANT_ALLOW_INSECURE_UPSTREAM=0

# Local/dev only: skip the real Pi Agent and use the scripted fake runtime.
# Production must stay unset or 0.
ASSISTANT_FAKE_AGENT=0

# V14 search quality flags. Keep 0 until a phase is certified.
# Phase 1: ASSISTANT_SEARCH_V2=1
# Phase 2: PODCASTINDEX_ENABLED=1 with key/secret
# Phase 3: YOUTUBE_HYDRATION_ENABLED=1
ASSISTANT_SEARCH_V2=0
PODCASTINDEX_ENABLED=0
YOUTUBE_HYDRATION_ENABLED=0
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
PODCASTINDEX_API_BASE_URL=https://api.podcastindex.org/api/1.0
PODCASTINDEX_TIMEOUT_MS=10000
SEARCH_SUCCESS_TTL_SECONDS=1800
SEARCH_EMPTY_TTL_SECONDS=300

# V15 workspace research. Since V18 the assistant always serves V2; these optional features stay off.
# Do not set these to 1 in committed examples or production .env files.
ASSISTANT_SHARED_WRITE_ENABLED=0
ASSISTANT_WEB_ENABLED=0
ASSISTANT_QMD_ENABLED=0
# kimi reuses Pi kimi-coding OAuth (auth.json). Leave API key empty.
ASSISTANT_WEB_PROVIDER=
ASSISTANT_WEB_API_KEY=
ASSISTANT_SHARED_GRANTS_PATH=
ASSISTANT_RG_PATH=rg
ASSISTANT_MAX_ARTIFACT_BYTES=2097152
ASSISTANT_MAX_WEB_PAGE_BYTES=4194304
ASSISTANT_MAX_GREP_MATCHES=200
ASSISTANT_MAX_GREP_MS=5000

