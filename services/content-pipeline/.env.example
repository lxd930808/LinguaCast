# Content pipeline configuration example. Copy to .env (chmod 600) on your server.
# Full self-host stack: deploy/self-host (generates a consistent .env for all services).
# All values are examples; real secrets must only live in the deployed env file.

# Loopback-only is enforced; any other value fails startup. Exception for
# container deploys: CONTENT_HOST=0.0.0.0 + CONTENT_BIND_ALL_INTERFACES=1 is
# accepted only because the compose file publishes 127.0.0.1:3220 exclusively.
CONTENT_HOST=127.0.0.1
CONTENT_PORT=3220

# Rotatable client bearer token (min 8 chars; use 32+ random chars in production).
# V18 identity: selfhost (single deployment token) or account (account-service introspection).
CONTENT_IDENTITY_MODE=selfhost
CONTENT_SERVICE_TOKEN=change-me-service-token
CONTENT_PIPELINE_VERSION=v10.1

# Existing media-api (internal access only).
MEDIA_API_BASE_URL=http://127.0.0.1:3210
MEDIA_API_TOKEN=change-me-media-api-token

# DashScope ASR.
DASHSCOPE_API_KEY=change-me-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Translation provider: dashscope, openrouter or deepseek.
TRANSLATION_PROVIDER=openrouter
TRANSLATION_BASE_URL=https://openrouter.ai/api
TRANSLATION_API_KEY=change-me-translation-key
TRANSLATION_MODEL=openai/gpt-4o-mini
TRANSLATION_REASONING_EFFORT=low
# Whole request deadline includes response body generation; 2 retries = 3 attempts.
TRANSLATION_REQUEST_TIMEOUT_MS=300000
TRANSLATION_NETWORK_RETRIES=2
# To use DeepSeek directly, replace the five provider settings above together:
# TRANSLATION_PROVIDER=deepseek
# TRANSLATION_BASE_URL=https://api.deepseek.com
# TRANSLATION_API_KEY=<your DeepSeek API key>
# TRANSLATION_MODEL=deepseek-v4-flash
# TRANSLATION_REASONING_EFFORT=high
# DeepSeek accepts high|max here, matching the App; do not keep OpenRouter's low.

# Cloudflare R2 (dedicated token, content-pipeline prefix only).
R2_ACCOUNT_ID=example-account-id
R2_ACCESS_KEY_ID=example-access-key
R2_SECRET_ACCESS_KEY=example-secret-key
R2_BUCKET=linguacast
R2_PREFIX=content-pipeline
R2_ENVIRONMENT=prod
R2_SIGNED_URL_TTL_SECONDS=3600

# Limits and paths.
CONTENT_MAX_BODY_BYTES=65536
CONTENT_MAX_MEDIA_BYTES=419430400
CONTENT_MAX_MEDIA_DURATION_SECONDS=14400
CONTENT_DISK_WATERMARK_BYTES=5368709120
CONTENT_TEMP_ROOT=/var/lib/linguacast-content/tmp
CONTENT_DATABASE_PATH=/var/lib/linguacast-content/data/content.db

# V12 durable YouTube MP4 promotion. Keep off until a canary flip; 0 budget = unlimited.
VIDEO_MEDIA_PROMOTION_ENABLED=0
CONTENT_VIDEO_MEDIA_RETENTION_DAYS=30
CONTENT_VIDEO_MEDIA_CLEANUP_INTERVAL_SECONDS=21600
CONTENT_VIDEO_MEDIA_CLEANUP_BATCH_SIZE=50
CONTENT_VIDEO_MEDIA_BUDGET_BYTES=107374182400
