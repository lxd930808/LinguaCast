PORT=3210
HOST=0.0.0.0
PUBLIC_BASE_URL=http://192.168.x.x:3210
AUTH_TOKEN=replace-me
MEDIA_ROOT=./.data/media
PREFERRED_HEIGHT=720
MAX_CONCURRENT_JOBS=1
JOB_TTL_MS=2700000
MIN_FREE_BYTES=5368709120
DOWNLOAD_ENGINE=ytdlp
YT_DLP_BIN=yt-dlp
YT_DLP_JS_RUNTIME=node
POT_BASE_URL=http://127.0.0.1:4416
REQUIRE_MEDIA_AUTH=true
# Optional legacy Mac LAN path:
# DOWNLOAD_ENGINE=sabr
# YT_SABR_CLIENT=ANDROID_VR
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional Cloudflare R2 (leave blank to serve /media from this host):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_KEY_PREFIX=yt-media
# R2_SIGNED_URL_TTL_SECONDS=3600
