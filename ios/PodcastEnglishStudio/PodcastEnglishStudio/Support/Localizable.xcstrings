    "settings.generation_backend.help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الخدمة السحابية على خادمك. الوضع على الجهاز يستخدم المفاتيح المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Clouddienst erzeugt auf Ihrem Server. Auf dem Gerät werden lokale Schlüssel verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud Service runs generation on your server. On-Device uses keys stored on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube genera en tu servidor. En el dispositivo usa las claves locales."
          }
        },
        "fr" : {
          "stringUnit" : {
