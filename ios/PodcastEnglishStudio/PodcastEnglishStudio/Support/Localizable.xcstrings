    "settings.cloud_status.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكون الخدمة جاهزة عند تفعيلها وإعداد رمز وصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst ist bereit, wenn er aktiviert ist und ein Zugriffstoken vorliegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is ready when it is enabled and an access token is configured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio está listo cuando está activado y hay un token de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service est prêt lorsqu’il est activé et qu’un jeton d’accès est configuré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効でアクセストークンが設定されているとサービスは準備完了です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 켜져 있고 액세스 토큰이 있으면 준비된 상태입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço fica pronto quando está ativado e um token de acesso está configurado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务已启用且配置了访问令牌时即为就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務已啟用且設定了存取權杖時即為就緒。"
          }
        }
      }
    },
