          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Untertitelgenerierung kann dieses Video nicht verarbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud subtitle generation cannot process this video."
          }
