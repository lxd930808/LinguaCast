          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le service de génération cloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド生成サービスを有効化"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 생성 서비스 활성화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar o serviço de geração na nuvem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用云端生成服务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用雲端生成服務"
          }
        }
      }
    },
    "settings.cloud_service_help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الإنشاء السحابي على خادمك الخاص، لذا لا يحتاج هذا الجهاز إلى مفاتيح DashScope أو الترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Generierung läuft auf deinem eigenen Server, daher benötigt dieses Gerät keine DashScope- oder Übersetzungsschlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud generation runs on your own server, so this device does not need DashScope or translation keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación en la nube se ejecuta en tu propio servidor, por lo que este dispositivo no necesita claves de DashScope ni de traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération cloud s’exécute sur votre propre serveur ; cet appareil n’a donc pas besoin de clés DashScope ni de traduction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド生成は自分のサーバーで実行されるため、このデバイスには DashScope や翻訳キーは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 생성은 사용자의 서버에서 실행되므로 이 기기에는 DashScope 또는 번역 키가 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geração na nuvem roda no seu próprio servidor, portanto este dispositivo não precisa de chaves do DashScope ou de tradução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端生成在你自己的服务器上运行，因此本设备无需 DashScope 或翻译密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端生成在你自己的伺服器上運行，因此本裝置無需 DashScope 或翻譯金鑰。"
          }
        }
      }
    },
