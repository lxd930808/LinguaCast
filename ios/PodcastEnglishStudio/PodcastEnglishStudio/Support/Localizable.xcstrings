    "today.open_a_channel_on_programs_to_refresh": {
      "comment": "Home empty-state guidance after subscriptions are added.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إضافة اشتراك، افتح قناته في صفحة البرامج لتحديث الحلقات أو مقاطع الفيديو المتاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne nach dem Hinzufügen eines Abonnements den Kanal unter „Programme“, um verfügbare Folgen oder Videos zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adding a subscription, open its channel on the Programs page to refresh available episodes or videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de añadir una suscripción, abre su canal en Programas para actualizar los episodios o vídeos disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir ajouté un abonnement, ouvrez sa chaîne dans Programmes pour actualiser les épisodes ou vidéos disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションを追加したら、番組ページでチャンネルを開き、利用可能なエピソードや動画を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 추가한 후 프로그램 페이지에서 채널을 열어 사용 가능한 에피소드나 동영상을 새로 고치세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de adicionar uma assinatura, abra o canal em Programas para atualizar os episódios ou vídeos disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加订阅后，请在“节目”页打开对应频道并刷新可用节目或视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增訂閱後，請在「節目」頁開啟對應頻道並重新整理可用節目或影片。"
          }
        }
      }
    },
