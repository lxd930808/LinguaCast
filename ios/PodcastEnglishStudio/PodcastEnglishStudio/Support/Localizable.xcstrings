    "cloud.error.capacity": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة المحتوى تعمل بكامل طاقتها. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaltsdienst ist ausgelastet. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content service is at capacity. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de contenido está al límite de su capacidad. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de contenu est saturé. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツサービスが容量の上限に達しています。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 서비스가 용량 한도에 도달했습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de conteúdo está no limite da capacidade. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容服务已满负荷，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容服務已滿載，請稍後重試。"
          }
        }
      }
    },
