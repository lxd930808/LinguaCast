    "error.youtube_page_limit": {
      "comment": "YouTube pagination stopped at a safety limit.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الوصول إلى النهاية بعد تحميل %@ صفحة. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Laden von %@ Seiten wurde das Ende nicht erreicht. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end was not reached after loading %@ pages. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se llegó al final después de cargar %@ páginas. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fin n’a pas été atteinte après le chargement de %@ pages. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ページを読み込んでも末尾に到達しませんでした。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@페이지를 불러온 후에도 끝에 도달하지 못했습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim não foi alcançado após carregar %@ páginas. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续加载 %@ 页后仍未到末尾，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續載入 %@ 頁後仍未到末尾，請稍後再試。"
          }
        }
      }
    },
