    "error.asr_resume_data_missing" : {
      "comment" : "Shown when a pre-upgrade transcription has no durable DashScope task checkpoint",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استئناف النسخ السابق لأن معلومات المهمة لم تُحفظ. اضغط على «إعادة المحاولة» لبدء المهمة من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vorherige Transkription kann nicht fortgesetzt werden, da ihre Auftragsinformationen nicht gespeichert wurden. Tippe auf „Wiederholen“, um sie neu zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The previous transcription cannot be resumed because its task information was not saved. Tap Retry to start it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcripción anterior no se puede reanudar porque no se guardó la información de la tarea. Toca Reintentar para iniciarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription précédente ne peut pas reprendre, car les informations de sa tâche n’ont pas été enregistrées. Touchez Réessayer pour la recommencer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の文字起こしはタスク情報が保存されていないため再開できません。「再試行」をタップして開始し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 음성 변환의 작업 정보가 저장되지 않아 재개할 수 없습니다. 다시 시도하여 새로 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transcrição anterior não pode ser retomada porque as informações da tarefa não foram salvas. Toque em Tentar novamente para reiniciá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次转写没有保存任务信息，无法恢复。请点“重试”重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次轉寫沒有儲存任務資訊，無法恢復。請點「重試」重新開始。"
          }
        }
      }
    },
