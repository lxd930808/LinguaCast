    "account.sign_in_help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام Apple لاستخدام النسخ والترجمة السحابيين ومساعد البحث. يظل المحتوى الموجود على هذا الجهاز قابلاً للتشغيل دون تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, um Cloud-Transkription, Übersetzung und den Recherche-Assistenten zu nutzen. Inhalte auf diesem Gerät bleiben ohne Anmeldung abspielbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple to use cloud transcription, translation and the research assistant. Content already on this device stays playable without signing in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para usar la transcripción y traducción en la nube y el asistente de investigación. El contenido de este dispositivo se puede reproducir sin iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour utiliser la transcription et la traduction dans le cloud ainsi que l’assistant de recherche. Le contenu déjà présent sur cet appareil reste lisible sans connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple でサインインすると、クラウドの文字起こし・翻訳とリサーチアシスタントを利用できます。このデバイスにあるコンテンツはサインインしなくても再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인하면 클라우드 받아쓰기, 번역 및 리서치 어시스턴트를 사용할 수 있습니다. 이 기기에 있는 콘텐츠는 로그인하지 않아도 재생할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com a Apple para usar transcrição e tradução na nuvem e o assistente de pesquisa. O conteúdo já neste dispositivo continua reproduzível sem entrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登录即可使用云端转写、翻译和研究助手。本设备上已有的内容无需登录也可播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入即可使用雲端轉寫、翻譯和研究助理。本裝置上已有的內容無需登入也能播放。"
          }
        }
      }
    },
