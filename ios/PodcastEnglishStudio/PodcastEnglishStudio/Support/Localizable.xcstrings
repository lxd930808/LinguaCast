    "cloud.error.local_pipeline_removed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد المعالجة على الجهاز متاحة. اضغط على إعادة المحاولة لمعالجة هذه الحلقة في السحابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung auf dem Gerät ist nicht mehr verfügbar. Tippe auf „Erneut versuchen“, um diese Folge in der Cloud zu verarbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device processing is no longer available. Tap Retry to process this episode in the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento en el dispositivo ya no está disponible. Toca Reintentar para procesar este episodio en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement sur l’appareil n’est plus disponible. Touchez Réessayer pour traiter cet épisode dans le cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上での処理は利用できなくなりました。「再試行」をタップすると、このエピソードをクラウドで処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 처리는 더 이상 사용할 수 없습니다. 다시 시도를 탭하여 이 에피소드를 클라우드에서 처리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento no dispositivo não está mais disponível. Toque em Tentar novamente para processar este episódio na nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端处理已不再提供。轻点“重试”即可在云端处理此单集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端處理已不再提供。點一下「重試」即可在雲端處理此單集。"
          }
        }
      }
    },
    "cloud.error.needs_upgrade": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدِّث التطبيق لمواصلة استخدام خدمة المحتوى السحابية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere die App, um den Cloud-Inhaltsdienst weiterhin zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the app to keep using the cloud content service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza la app para seguir usando el servicio de contenido en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour l’app pour continuer à utiliser le service de contenu cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドコンテンツサービスを引き続き利用するにはアプリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
