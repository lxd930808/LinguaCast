    "settings.local_media_token.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الرمز على هذا الجهاز ولا يُعرض كاملاً أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token liegt auf diesem Gerät und wird nie vollständig angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored on this device and never shown in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda en este dispositivo y nunca se muestra completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est stocké sur cet appareil et n’est jamais affiché en entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはこのデバイスに保存され、全文は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 이 기기에 저장되며 전체는 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token fica neste dispositivo e nunca é exibido por completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌保存在此设备上，不会完整显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權杖保存在此裝置上，不會完整顯示。"
          }
        }
      }
    },
    "settings.local_media_url.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن عنوان خدمة الوسائط على iPhone أو عبر الإعداد بالهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie die Medien-URL auf dem iPhone oder unter „Per iPhone einrichten“ fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the media service URL on iPhone or with Set Up by Phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la URL del servicio multimedia en el iPhone o con Configurar con el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez l’URL du service média sur iPhone ou via Configuration par téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアサービスのURLはiPhoneか「携帯電話で設定」で指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 서비스 URL은 iPhone 또는 휴대폰으로 설정에서 지정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o URL do serviço de mídia no iPhone ou em Configurar pelo telefone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上或通过「用手机配置」设置媒体服务地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 上或透過「用手機設定」設定媒體服務網址。"
          }
        }
      }
    },
