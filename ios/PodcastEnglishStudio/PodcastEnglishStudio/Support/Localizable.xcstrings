          "stringUnit": {
            "state": "translated",
            "value": "クラウド字幕生成ではこの動画を処理できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 자막 생성이 이 동영상을 처리할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
