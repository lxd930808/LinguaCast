    "cloud.error.source_restricted": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقيّد المنصة المصدر هذا الفيديو (المنطقة أو العمر أو تسجيل الدخول)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quellplattform schränkt dieses Video ein (Region, Alter oder Anmeldung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source platform restricts this video (region, age, or login)."
          }
        },
        "es": {
