    "settings.legacy_local_pipeline_help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم هذه المفاتيح فقط في خط المعالجة على الجهاز. تظل قابلة للتحرير هنا، وإعادة الواجهة الخلفية للإنشاء إلى «على الجهاز» تستعيد السلوك السابق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schlüssel werden nur von der On-Device-Pipeline verwendet. Sie bleiben hier bearbeitbar; ein Zurückschalten des Generierungs-Backends auf „Auf dem Gerät“ stellt das frühere Verhalten wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These keys are only used by the on-device pipeline. They remain editable here, and switching the generation backend back to On-Device restores the previous behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas claves solo las usa el pipeline del dispositivo. Siguen siendo editables aquí, y volver a cambiar el backend de generación a En el dispositivo restaura el comportamiento anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces clés ne sont utilisées que par le pipeline sur l’appareil. Elles restent modifiables ici, et repasser le backend de génération sur Sur l’appareil restaure le comportement précédent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのキーはオンデバイスパイプラインでのみ使用されます。ここで引き続き編集でき、生成バックエンドをオンデバイスに戻すと以前の動作に復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키는 기기 내 파이프라인에서만 사용됩니다. 여기에서 계속 편집할 수 있으며, 생성 백엔드를 기기 내로 다시 전환하면 이전 동작이 복원됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas chaves são usadas apenas pelo pipeline no dispositivo. Elas continuam editáveis aqui, e voltar o backend de geração para No dispositivo restaura o comportamento anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些密钥仅用于设备端流水线。它们仍可在此编辑；将生成后端切换回“设备端”即可恢复之前的行为。"
          }
