    "account.quota_help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إعادة تعيين الحدود اليومية المجانية عند منتصف الليل بتوقيت الصين الرسمي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Tageslimits werden um Mitternacht chinesischer Normalzeit zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free daily limits reset at midnight China Standard Time."
          }
        },
        "es": {
