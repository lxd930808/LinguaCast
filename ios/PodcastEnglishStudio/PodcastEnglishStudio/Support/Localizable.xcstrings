    "settings.used_to_get_channels_video_lists_thumbnails_and_release_times_vi" : {
      "comment" : "English master with machine-translated initial localizations.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم للحصول على القنوات وقوائم الفيديو والصور المصغرة وأوقات الإصدار عبر بيانات YouTube الرسمية API v3. Apple TV لا يزال التشغيل يحتفظ بالمسار المتوافق الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Kanäle, Videolisten, Miniaturansichten und Veröffentlichungszeiten über die offiziellen YouTube-Daten API v3 abzurufen. Apple TV Die Wiedergabe behält weiterhin den aktuellen kompatiblen Pfad bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to get channels, video lists, thumbnails and release times via the official YouTube Data API v3. Apple TV Playback still retains the current compatible path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se utiliza para obtener canales, listas de vídeos, miniaturas y tiempos de lanzamiento a través del YouTube Data API v3 oficial. Apple TV La reproducción aún conserva la ruta compatible actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour obtenir des chaînes, des listes de vidéos, des vignettes et des heures de sortie via les données officielles YouTube API v3. Apple TV La lecture conserve toujours le chemin compatible actuel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式 YouTube データ API v3 経由でチャンネル、ビデオ リスト、サムネイル、リリース時間を取得するために使用されます。 Apple TV 再生では、現在の互換性のあるパスが維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공식 YouTube 데이터 API v3을 통해 채널, 동영상 목록, 썸네일 및 출시 시간을 가져오는 데 사용됩니다. Apple TV 재생은 여전히 ​​현재 호환 경로를 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para obter canais, listas de vídeos, miniaturas e horários de lançamento por meio dos dados oficiais YouTube API v3. Apple TV A reprodução ainda mantém o caminho compatível atual."
          }
        },
        "zh-Hans" : {
