          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o app para continuar usando o serviço de conteúdo na nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 App 以继续使用云端内容服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新 App 以繼續使用雲端內容服務。"
          }
        }
      }
    },
    "cloud.error.not_configured": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإنشاء السحابي مفعَّل لكن خدمة المحتوى غير مهيأة."
          }
        },
        "de": {
          "stringUnit": {
