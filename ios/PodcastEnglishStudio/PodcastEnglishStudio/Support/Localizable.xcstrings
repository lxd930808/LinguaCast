    "assistant.v2.quota_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت محادثات المساعد المجانية لهذا اليوم. تتم إعادة تعيينها عند منتصف الليل بتوقيت الصين الرسمي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die kostenlosen Assistentenrunden für heute aufgebraucht. Sie werden um Mitternacht chinesischer Normalzeit zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used today's free assistant turns. They reset at midnight China Standard Time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste los turnos gratuitos del asistente de hoy. Se restablecen a medianoche, hora estándar de China."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé les échanges gratuits avec l’assistant pour aujourd’hui. Ils sont réinitialisés à minuit, heure normale de Chine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の無料アシスタント利用回数を使い切りました。中国標準時の午前0時にリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 무료 어시스턴트 대화를 모두 사용했습니다. 중국 표준시 자정에 초기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou os turnos gratuitos do assistente de hoje. Eles são redefinidos à meia-noite no horário padrão da China."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的免费助手轮次已用完，将在北京时间零点重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的免費助理輪次已用完，將於北京時間午夜重設。"
          }
        }
      }
    },
