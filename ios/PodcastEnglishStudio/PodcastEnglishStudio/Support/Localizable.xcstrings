    "assistant.prepare_confirm_body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا خدمة النسخ والترجمة السحابية. ولن يُنزَّل المحتوى على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür wird der Cloud-Dienst für Transkription und Übersetzung genutzt. Medien werden nicht auf diesem Gerät geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This uses the cloud transcription and translation service. It does not download media on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto usa el servicio de transcripción y traducción en la nube. No descarga el contenido en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela utilise le service cloud de transcription et de traduction. Aucun média n’est téléchargé sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドの文字起こしと翻訳サービスを使います。この端末にメディアは保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 전사 및 번역 서비스를 사용합니다. 이 기기에 미디어를 다운로드하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso usa o serviço de transcrição e tradução na nuvem. Não baixa a mídia neste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将调用云端转写翻译服务，不会在本机下载媒体。"
          }
