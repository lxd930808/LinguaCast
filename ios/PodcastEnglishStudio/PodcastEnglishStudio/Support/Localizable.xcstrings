    "ytaccount.login_only_occurs_on_the_google_page_and_the_app_does_not_read_o" : {
      "comment" : "English master with machine-translated initial localizations.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تسجيل الدخول فقط على صفحة Google، ولا يقرأ التطبيق كلمة مرور الحساب أو يحفظها. YouTube يتم تحديد عرض الإعلانات من خلال YouTube."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung erfolgt nur auf der Seite Google und die App liest oder speichert das Kontopasswort nicht. YouTube Ob Anzeigen angezeigt werden, wird durch YouTube bestimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login only occurs on the Google page, and the App does not read or save the account password. YouTube Whether to display ads is determined by YouTube."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión solo se produce en la página Google y la aplicación no lee ni guarda la contraseña de la cuenta. YouTube La visualización de anuncios está determinada por YouTube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion s'effectue uniquement sur la page Google et l'application ne lit ni n'enregistre le mot de passe du compte. YouTube L'affichage ou non des annonces est déterminé par YouTube."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインはGoogle ページでのみ行われ、アプリはアカウントのパスワードを読み取ったり保存したりしません。 YouTube 広告を表示するかどうかはYouTube によって決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인은 Google 페이지에서만 이루어지며, 앱은 계정 비밀번호를 읽거나 저장하지 않습니다. YouTube 광고 표시 여부는 YouTube에 따라 결정됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login ocorre apenas na página Google, e o App não lê nem salva a senha da conta. YouTube A exibição de anúncios é determinada por YouTube."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录只发生在 Google 页面内，App 不读取、不保存账号密码。YouTube 是否展示广告由 YouTube 决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入只發生在 Google 頁面內，App 不讀取、不儲存帳號密碼。 YouTube 是否展示廣告由 YouTube 決定。"
          }
        }
      }
    },
