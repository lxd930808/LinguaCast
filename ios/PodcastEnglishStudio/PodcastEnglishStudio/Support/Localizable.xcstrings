    "cloud.detail.account_changed": {
      "comment": "Why confirmation is required after an iCloud account change",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد قبل دمج البيانات المحلية في الحساب الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, bevor lokale Daten mit dem neuen Account zusammengeführt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm before merging local data into the new account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma antes de fusionar los datos locales con la cuenta nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez avant de fusionner les données locales avec le nouveau compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータを新しいアカウントに統合する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터를 새 계정에 병합하기 전에 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme antes de mesclar os dados locais com a nova conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认后再把本机数据合并到新账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認後再將本機資料合併到新帳號。"
          }
        }
      }
    },
    "cloud.detail.no_account": {
      "comment": "iCloud is unavailable but local data remains usable",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى البيانات المحلية متاحة. تبدأ المزامنة بعد تسجيل الدخول إلى iCloud."
          }
        },
        "de": {
          "stringUnit": {
