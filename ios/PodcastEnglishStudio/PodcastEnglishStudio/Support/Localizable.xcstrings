        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço na nuvem gera no seu servidor. No dispositivo usa as chaves locais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
