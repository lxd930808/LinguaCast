    "assistant.v2.greeting_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح سؤالًا أو صف موضوعًا. سأبحث في الويب وYouTube والبودكاست."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine Frage oder beschreiben Sie ein Thema. Ich durchsuche Web, YouTube und Podcasts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or describe a topic. I'll search the web, YouTube, and podcasts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta o describe un tema. Buscaré en la web, YouTube y pódcasts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question ou décrivez un sujet. Je chercherai sur le Web, YouTube et les podcasts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問するかトピックを書いてください。ウェブ、YouTube、ポッドキャストを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문을 하거나 주제를 설명하세요. 웹, YouTube, 팟캐스트를 검색합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta ou descreva um tópico. Vou buscar na web, no YouTube e em podcasts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出问题或描述主题。我会搜索网页、YouTube 和播客。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提出問題或描述主題。我會搜尋網頁、YouTube 和 Podcast。"
          }
        }
      }
    },
