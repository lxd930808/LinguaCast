    "error.youtube_unsupported_channel_input": {
      "comment": "Localized user-facing error or progress summary",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان القناة هذا غير مدعوم من YouTube Data API. استخدم @handle أو معرف القناة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kanaladresse wird von der YouTube Data API nicht unterstützt. Verwenden Sie ein @-Handle oder eine Kanal-ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel address is not supported by the YouTube Data API. Use an @handle or channel ID."
          }
