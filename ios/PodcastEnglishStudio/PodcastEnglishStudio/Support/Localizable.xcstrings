    "settings.cloud_token_privacy_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن الرمز في سلسلة المفاتيح ولا يُعرض كاملًا أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird im Schlüsselbund gespeichert und nie vollständig angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored in the Keychain and never shown in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda en el llavero y nunca se muestra completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est stocké dans le trousseau et n’est jamais affiché en entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはキーチェーンに保存され、完全には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 키체인에 저장되며 전체가 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token é armazenado no chaveiro e nunca é exibido por completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌存储在钥匙串中，绝不会完整显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權杖儲存在鑰匙圈中，絕不會完整顯示。"
          }
        }
      }
    },
    "settings.cloud_token.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الرمز في سلسلة المفاتيح ولا يُعرض كاملاً أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token liegt in der Keychain und wird nie vollständig angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored in the Keychain and never shown in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda en el llavero y nunca se muestra completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est stocké dans le trousseau et n’est jamais affiché en entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはキーチェーンに保存され、全文は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 키체인에 저장되며 전체는 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token fica no Keychain e nunca é exibido por completo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌保存在钥匙串中，不会完整显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權杖保存在鑰匙圈中，不會完整顯示。"
          }
        }
      }
    },
    "settings.cloud_url.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
