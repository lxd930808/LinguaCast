    "settings.content_filter_help" : {
      "comment" : "Content filter explanation text",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إخفاء الحلقات والفيديوهات المطابقة من القوائم. تعمل الكلمات المفتاحية فورًا؛ أما تعليمات الوكيل فتستخدم نموذج الترجمة المُهيأ عند توفره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passende Episoden und Videos werden in Listen ausgeblendet. Stichwörter wirken sofort; die Agent-Anweisung nutzt bei Verfügbarkeit das konfigurierte Übersetzungs-LLM."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matching episodes and videos are hidden from lists. Keywords apply instantly; the agent instruction uses the configured Translation LLM when available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios y videos coincidentes se ocultan de las listas. Las palabras clave se aplican al instante; la instrucción del agente usa el LLM de traducción configurado cuando está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes et vidéos correspondants sont masqués des listes. Les mots-clés s'appliquent instantanément ; l'instruction de l'agent utilise le LLM de traduction configuré lorsqu'il est disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するエピソードや動画はリストに表示されなくなります。キーワードは即時に適用され、エージェント指示は設定済みの翻訳LLMが利用可能な場合に使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 에피소드와 동영상이 목록에서 숨겨집니다. 키워드는 즉시 적용되며, 에이전트 지시는 구성된 번역 LLM이 있을 때 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios e vídeos correspondentes ficam ocultos nas listas. As palavras-chave se aplicam instantaneamente; a instrução do agente usa o LLM de tradução configurado quando disponível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配的剧集和视频将在列表中隐藏。关键词即时生效；代理指令会在已配置翻译 LLM 时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配的劇集和影片將在列表中隱藏。關鍵詞即時生效；代理指令會在已配置翻譯 LLM 時使用。"
          }
        }
      }
    },
