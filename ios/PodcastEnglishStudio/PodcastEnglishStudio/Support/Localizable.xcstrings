    "assistant.v2.memory_proposal_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التأكيد يمكن استدعاء هذا التفضيل في الأبحاث القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Bestätigung kann diese Einstellung in späteren Recherchen abgerufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming this preference can be recalled in future research."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la confirma, esta preferencia se podrá recordar en investigaciones futuras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois confirmée, cette préférence pourra être rappelée dans de futures recherches."
