    },
    "cloud.error.invalid_response": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت خدمة المحتوى استجابة غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaltsdienst hat eine ungültige Antwort zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content service returned an invalid response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de contenido devolvió una respuesta no válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de contenu a renvoyé une réponse invalide."
