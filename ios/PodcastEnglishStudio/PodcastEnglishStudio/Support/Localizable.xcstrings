    "mobile_setup.if_the_page_cannot_be_opened_on_your_phone_please_confirm_that_a" : {
      "comment" : "English master with machine-translated initial localizations.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تعذر فتح الصفحة على هاتفك، فيرجى التأكد من أن Apple TV سمح بالوصول إلى الشبكة المحلية وإيقاف تشغيل شبكة الضيف أو عزل AP."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Seite auf Ihrem Telefon nicht geöffnet werden kann, bestätigen Sie bitte, dass Apple TV den lokalen Netzwerkzugriff zugelassen hat, und deaktivieren Sie die Gastnetzwerk- oder AP-Isolierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the page cannot be opened on your phone, please confirm that Apple TV has allowed local network access and turn off guest network or AP isolation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la página no se puede abrir en su teléfono, confirme que Apple TV haya permitido el acceso a la red local y desactive la red de invitados o el aislamiento de AP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la page ne peut pas être ouverte sur votre téléphone, veuillez confirmer que Apple TV a autorisé l'accès au réseau local et désactivez le réseau invité ou l'isolation AP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "携帯電話でページを開けない場合は、Apple TV がローカル ネットワーク アクセスを許可していることを確認し、ゲスト ネットワークまたは AP 分離をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰에서 페이지를 열 수 없는 경우 Apple TV에서 로컬 네트워크 액세스를 허용했는지 확인하고 게스트 네트워크 또는 AP 격리를 해제하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a página não puder ser aberta no seu telefone, confirme se Apple TV permitiu o acesso à rede local e desative a rede de convidados ou o isolamento de AP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果手机打不开页面，请确认 Apple TV 已允许本地网络访问，并关闭访客网络或 AP 隔离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果手機打不開頁面，請確認 Apple TV 已允許本地網路訪問，並關閉訪客網路或 AP 隔離。"
          }
        }
      }
    },
