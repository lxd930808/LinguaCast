        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las investigaciones nuevas usan la API de espacio de trabajo V15. Déjelo desactivado para conservar el asistente anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, les nouvelles recherches utilisent l’API d’espace de travail V15. Laissez désactivé pour conserver l’assistant précédent."
          }
        },
        "ja" : {
          "stringUnit" : {
