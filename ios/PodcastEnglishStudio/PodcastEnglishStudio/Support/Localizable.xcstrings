    "settings.translation_language.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر لغة الترجمة على iPhone أو عبر الإعداد بالهاتف. تبقى الترجمات الحالية على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie die Übersetzungssprache auf dem iPhone oder unter „Per iPhone einrichten“. Vorhandene Übersetzungen bleiben auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the translation language on iPhone or with Set Up by Phone. Existing translations remain available on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el idioma de traducción en el iPhone o con Configurar con el teléfono. Las traducciones existentes siguen disponibles en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez la langue de traduction sur iPhone ou via Configuration par téléphone. Les traductions existantes restent disponibles sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳言語はiPhoneか「携帯電話で設定」で変更してください。既存の訳はこのデバイスで引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 언어는 iPhone 또는 휴대폰으로 설정에서 바꾸세요. 기존 번역은 이 기기에 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o idioma de tradução no iPhone ou em Configurar pelo telefone. As traduções existentes continuam neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上或通过「用手机配置」更改翻译语言。此设备上的已有译文仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 上或透過「用手機設定」更改翻譯語言。此裝置上的既有譯文仍可使用。"
          }
        }
