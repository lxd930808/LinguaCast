    "settings.local_media_mode.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 ينزّل ملفًا. HLS يبث فيديو متكيفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 lädt eine Datei. HLS streamt adaptives Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 downloads a file. HLS streams adaptive video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 descarga un archivo. HLS transmite vídeo adaptable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 télécharge un fichier. HLS diffuse une vidéo adaptative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4はファイルをダウンロードします。HLSは適応ビットレートで配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4는 파일을 다운로드합니다. HLS는 적응형 비디오를 스트리밍합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 baixa um arquivo. HLS transmite vídeo adaptativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 会下载文件。HLS 以自适应方式串流视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 會下載檔案。HLS 以自適應方式串流影片。"
          }
        }
      }
    },
