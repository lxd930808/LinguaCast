    "settings.local_media_help" : {
      "comment" : "English master with machine-translated initial localizations.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-hosted yt-dlp backend for HD. Default 720p saves disk. Leave disabled to use on-device extraction."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自建 yt-dlp 后端用于高清播放。默认 720p 节省磁盘。关闭则使用设备端提取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自建 yt-dlp 後端用於高畫質播放。預設 720p 節省磁碟。關閉則使用裝置端擷取。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backend yt-dlp propio para HD. 720p por defecto ahorra disco. Desactivado = extracción en el dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backend yt-dlp próprio para HD. 720p por padrão economiza disco. Desativado = extração no dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HD 再生用の自前 yt-dlp バックエンド。既定 720p で容量節約。オフで端末内抽出。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HD용 자체 yt-dlp 백엔드. 기본 720p로 디스크 절약. 끄면 기기 내 추출."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backend yt-dlp auto-hébergé pour le HD. 720p par défaut pour économiser l’espace. Désactivé = extraction sur l’appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst gehostetes yt-dlp-Backend für HD. Standard 720p spart Speicher. Aus = Extraktion auf dem Gerät."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلفية yt-dlp ذاتية الاستضافة للوضوح العالي. الافتراضي 720p يوفر المساحة. عند الإيقاف يُستخدم الاستخراج على الجهاز."
          }
        }
      }
    },
