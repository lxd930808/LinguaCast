{
  "sourceLanguage" : "en",
  "strings" : {
    "cloud.detail.disabled" : {"comment" : "CloudKit is not configured and local data remains available", "localizations" : {"ar" : {"stringUnit" : {"state" : "translated", "value" : "لم يتم إعداد CloudKit. تظل البيانات المحلية متاحة على هذا الجهاز."}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit ist nicht konfiguriert. Lokale Daten bleiben auf diesem Gerät verfügbar."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit is not configured. Local data remains available on this device."}}, "es" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit no está configurado. Los datos locales siguen disponibles en este dispositivo."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit n’est pas configuré. Les données locales restent disponibles sur cet appareil."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit は設定されていません。ローカルデータはこのデバイスで引き続き利用できます。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit이 구성되지 않았습니다. 로컬 데이터는 이 기기에서 계속 사용할 수 있습니다."}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "O CloudKit não está configurado. Os dados locais continuam disponíveis neste dispositivo."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit 未配置，本机数据仍可在此设备上使用。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "CloudKit 尚未設定，本機資料仍可在此裝置上使用。"}}}},
    "cloud.status.disabled" : {"comment" : "Cloud synchronization is not configured", "localizations" : {"ar" : {"stringUnit" : {"state" : "translated", "value" : "مزامنة iCloud متوقفة"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "iCloud-Synchronisierung ist aus"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "iCloud Sync Is Off"}}, "es" : {"stringUnit" : {"state" : "translated", "value" : "La sincronización de iCloud está desactivada"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "La synchronisation iCloud est désactivée"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "iCloud 同期はオフです"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "iCloud 동기화 꺼짐"}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A sincronização do iCloud está desativada"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "iCloud 同步已关闭"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "iCloud 同步已關閉"}}}},
    "cloud.detail.account_changed" : {
      "comment" : "Why confirmation is required after an iCloud account change",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد قبل دمج البيانات المحلية في الحساب الجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige, bevor lokale Daten mit dem neuen Account zusammengeführt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm before merging local data into the new account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma antes de fusionar los datos locales con la cuenta nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez avant de fusionner les données locales avec le nouveau compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルデータを新しいアカウントに統合する前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 데이터를 새 계정에 병합하기 전에 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme antes de mesclar os dados locais com a nova conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认后再把本机数据合并到新账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認後再將本機資料合併到新帳號。"
          }
        }
      }
    },
    "cloud.detail.no_account" : {
      "comment" : "iCloud is unavailable but local data remains usable",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى البيانات المحلية متاحة. تبدأ المزامنة بعد تسجيل الدخول إلى iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Daten bleiben verfügbar. Die Synchronisierung startet nach der iCloud-Anmeldung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local data remains available. Sync starts after you sign in to iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos locales siguen disponibles. La sincronización comenzará al iniciar sesión en iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données locales restent disponibles. La synchronisation démarre après la connexion à iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルデータは利用できます。iCloud へのサインイン後に同期が始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 데이터는 계속 사용할 수 있습니다. iCloud에 로그인하면 동기화가 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados locais continuam disponíveis. A sincronização começa após iniciar sessão no iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机数据仍可使用；登录 iCloud 后会自动同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機資料仍可使用；登入 iCloud 後會自動同步。"
          }
        }
      }
    },
    "cloud.detail.starting" : {
      "comment" : "iCloud startup detail",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
