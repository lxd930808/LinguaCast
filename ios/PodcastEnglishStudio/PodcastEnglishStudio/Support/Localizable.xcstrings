          }
        }
      }
    },
    "account.delete_confirm_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى تسجيل خروجك على جميع الأجهزة وحذف مهامك السحابية وأبحاثك وتفضيلاتك. يتم الاحتفاظ بالمحتوى الذي تم تنزيله على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wirst du auf allen Geräten abgemeldet und deine Cloud-Aufträge, Recherchen und Einstellungen werden gelöscht. Auf dieses Gerät geladene Inhalte bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out on all devices and deletes your cloud jobs, research and preferences. Content downloaded to this device is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión en todos los dispositivos y se eliminarán tus tareas en la nube, investigaciones y preferencias. El contenido descargado en este dispositivo se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté sur tous les appareils et vos tâches cloud, recherches et préférences seront supprimées. Le contenu téléchargé sur cet appareil est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスでサインアウトし、クラウドのジョブ、リサーチ、設定を削除します。このデバイスにダウンロードしたコンテンツは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃되고 클라우드 작업, 리서치 및 환경설정이 삭제됩니다. 이 기기에 다운로드한 콘텐츠는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso encerra sua sessão em todos os dispositivos e exclui suas tarefas na nuvem, pesquisas e preferências. O conteúdo baixado neste dispositivo é mantido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在所有设备上退出登录，并删除你的云端任务、研究和偏好设置。已下载到本设备的内容会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將在所有裝置上登出，並刪除你的雲端任務、研究和偏好設定。已下載到本裝置的內容會保留。"
          }
        }
      }
    },
