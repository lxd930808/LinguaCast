    "root.setup_needs_youtube_key_and_cloud_service": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح YouTube Data API وسجّل الدخول أو اتصل بخادم قبل إضافة المحتوى أو تحديثه."
          }
        },
        "de": {
          "stringUnit": {
