          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesem Apple Podcasts-Link handelt es sich nicht um eine einzelne Sendung. Fügen Sie einen Show-Link oder RSS-Feed hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Podcasts link is not an individual show. Add a show link or RSS feed."
          }
        },
        "es": {
