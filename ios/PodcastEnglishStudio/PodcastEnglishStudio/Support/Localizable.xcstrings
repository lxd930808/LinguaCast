    "settings.root.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر فئة. تُطبَّق التغييرات فورًا وتُزامَن مع iCloud عند التوفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Kategorie. Änderungen gelten sofort und werden mit iCloud synchronisiert, wenn verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category. Changes apply immediately and sync with iCloud when available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una categoría. Los cambios se aplican al instante y se sincronizan con iCloud si está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une catégorie. Les modifications s’appliquent immédiatement et se synchronisent avec iCloud si disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを選びます。変更はすぐに反映され、可能ならiCloudと同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 선택하세요. 변경은 바로 적용되며 가능하면 iCloud와 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria. As alterações valem na hora e sincronizam com o iCloud quando disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个分类。更改会立即生效，并在可用时与 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個分類。變更會立即生效，並在可用時與 iCloud 同步。"
          }
        }
      }
    },
