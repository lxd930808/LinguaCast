          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen und Abonnements bleiben zwischen iPhone und Apple TV synchron."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings, subscriptions, and completed subtitle results stay in sync between iPhone and Apple TV."
          }
