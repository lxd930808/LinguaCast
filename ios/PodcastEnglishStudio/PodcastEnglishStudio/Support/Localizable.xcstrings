    "settings.the_first_version_does_not_generate_chinese_synthesized_episodes" : {
      "comment" : "English master with machine-translated initial localizations.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقوم الإصدار الأول بإنشاء حلقات مركبة صينية بشكل افتراضي، ويتم الاحتفاظ بهذا التكوين لتحويل النص إلى كلام (TTS) اللاحق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Version generiert standardmäßig keine chinesisch synthetisierten Episoden und diese Konfiguration wird für nachfolgende TTS beibehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first version does not generate Chinese synthesized episodes by default, and this configuration is retained for subsequent TTS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera versión no genera episodios sintetizados en chino de forma predeterminada y esta configuración se conserva para TTS posteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première version ne génère pas d'épisodes synthétisés chinois par défaut, et cette configuration est conservée pour les TTS suivants."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のバージョンでは、デフォルトでは中国語の合成エピソードが生成されず、この構成は後続の TTS でも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 버전은 기본적으로 중국어 합성 에피소드를 생성하지 않으며 이 구성은 후속 TTS에도 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A primeira versão não gera episódios sintetizados em chinês por padrão, e esta configuração é mantida para TTS subsequentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
