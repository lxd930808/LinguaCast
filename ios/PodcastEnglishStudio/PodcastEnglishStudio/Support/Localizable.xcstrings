        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiv, nutzen neue Recherchen die V15-Workspace-API. Ausgeschaltet bleibt die bisherige Assistentenerfahrung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, new research uses the V15 workspace API. Leave this off to keep the previous assistant experience."
