    "ytplayer.quality_unavailable_using_best" : {"comment" : "Playback quality fallback notice", "localizations" : {"ar" : {"stringUnit" : {"state" : "translated", "value" : "الجودة المطلوبة غير متاحة؛ يتم استخدام أفضل بث قابل للتشغيل."}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Die gewünschte Qualität ist nicht verfügbar; der beste abspielbare Stream wird verwendet."}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Requested quality unavailable; using best playable stream."}}, "es" : {"stringUnit" : {"state" : "translated", "value" : "La calidad solicitada no está disponible; se usa la mejor transmisión reproducible."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "La qualité demandée est indisponible ; utilisation du meilleur flux lisible."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "指定した画質を利用できないため、再生可能な最適ストリームを使用します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "요청한 화질을 사용할 수 없어 재생 가능한 최적 스트림을 사용합니다."}}, "pt-BR" : {"stringUnit" : {"state" : "translated", "value" : "A qualidade solicitada não está disponível; usando o melhor stream reproduzível."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请求的画质不可用，正在使用最佳可播放流。"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要求的畫質無法使用，正在使用最佳可播放串流。"}}}},
