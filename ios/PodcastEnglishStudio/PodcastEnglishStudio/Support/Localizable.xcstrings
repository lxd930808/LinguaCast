    "settings.assistant_v2_help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التشغيل تستخدم الأبحاث الجديدة واجهة مساحة العمل V15. اتركه مغلقًا للإبقاء على تجربة المساعد السابقة."
