    "cloud.error.not_retryable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة محاولة هذا الفشل مباشرة. استخدم «مسح وإعادة الإنشاء» للبدء من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Fehler kann nicht direkt wiederholt werden. Nutze „Löschen und neu generieren“, um von vorn zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This failure cannot be retried directly. Use Clear and regenerate to start over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fallo no se puede reintentar directamente. Usa Borrar y regenerar para empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet échec ne peut pas être relancé directement. Utilisez Effacer et régénérer pour recommencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この失敗は直接再試行できません。「クリアして再生成」でやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실패는 바로 다시 시도할 수 없습니다. \"지우고 다시 생성\"을 사용해 처음부터 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta falha não pode ser tentada novamente diretamente. Use Limpar e regenerar para recomeçar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此失败无法直接重试。请使用“清除并重新生成”重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此失敗無法直接重試。請使用「清除並重新生成」重新開始。"
          }
        }
      }
    },
    "cloud.error.quota_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استنفاد وقت المعالجة المجاني لهذا اليوم. تتم إعادة تعيينه عند منتصف الليل بتوقيت الصين الرسمي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Verarbeitungszeit für heute ist aufgebraucht. Sie wird um Mitternacht chinesischer Normalzeit zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's free processing time is used up. It resets at midnight China Standard Time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de procesamiento gratuito de hoy. Se restablece a medianoche, hora estándar de China."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de traitement gratuit du jour est épuisé. Il est réinitialisé à minuit, heure normale de Chine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の無料処理時間を使い切りました。中国標準時の午前0時にリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 무료 처리 시간을 모두 사용했습니다. 중국 표준시 자정에 초기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de processamento gratuito de hoje acabou. Ele é redefinido à meia-noite no horário padrão da China."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的免费处理时长已用完，将在北京时间零点重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的免費處理時長已用完，將於北京時間午夜重設。"
          }
        }
      }
    },
    "cloud.error.quota_request_too_large": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنصر أطول من وقت المعالجة اليومي المجاني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element ist länger als die kostenlose tägliche Verarbeitungszeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is longer than the free daily processing time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento dura más que el tiempo de procesamiento diario gratuito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément dépasse le temps de traitement quotidien gratuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は1日の無料処理時間より長いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 일일 무료 처리 시간보다 깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é mais longo que o tempo de processamento diário gratuito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该内容时长超过每日免费处理时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該內容時長超過每日免費處理時長。"
          }
        }
      }
    },
    "cloud.error.rate_limited": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّ المنصة المصدر من الطلبات. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quellplattform begrenzt die Anfragen. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source platform is rate limiting requests. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plataforma de origen está limitando las solicitudes. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plateforme source limite les requêtes. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースプラットフォームがリクエストを制限しています。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 플랫폼이 요청을 제한하고 있습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A plataforma de origem está limitando as requisições. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源平台正在限流，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源平台正在限流，請稍後重試。"
          }
        }
      }
    },
    "cloud.error.retryable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل إنشاء الترجمة السحابية؛ قد تنجح إعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Untertitelgenerierung ist fehlgeschlagen; ein erneuter Versuch könnte gelingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud subtitle generation failed; a retry may succeed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación de subtítulos en la nube falló; un reintento podría funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération des sous-titres dans le cloud a échoué ; une nouvelle tentative peut réussir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド字幕生成に失敗しました。再試行で成功する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
