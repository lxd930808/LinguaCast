    "settings.subtitle_target_help": {
      "comment": "Subtitle target behavior explanation",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الترجمات الجديدة هذه اللغة. تبقى الترجمات الحالية متاحة على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Untertitel verwenden diese Sprache. Vorhandene Übersetzungen bleiben auf diesem Gerät verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New subtitles use this language. Existing translations remain available on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos nuevos usarán este idioma. Las traducciones existentes seguirán disponibles en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux sous-titres utilisent cette langue. Les traductions existantes restent disponibles sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい字幕にはこの言語が使われます。既存の翻訳はこのデバイスに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 자막은 이 언어를 사용합니다. 기존 번역은 이 기기에 계속 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas legendas usarão este idioma. As traduções existentes continuarão disponíveis neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新字幕使用此目标语言；已生成译文会继续保留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新字幕使用此目標語言；已產生的譯文會繼續保留在本機。"
          }
        }
      }
    },
