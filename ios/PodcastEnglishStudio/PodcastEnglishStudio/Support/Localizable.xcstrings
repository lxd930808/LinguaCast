    "settings.translation_quality_mode_help": {
      "comment": "Translation quality mode help text",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجودة تترجم ثم تحسّن كل سطر؛ السريع يترجم في تمريرة واحدة. ينطبق فقط على الترجمات المُنشأة حديثًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualität übersetzt und verfeinert jede Zeile; Schnell übersetzt in einem Durchgang. Gilt nur für neu erzeugte Untertitel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality translates then refines each line; Fast translates in a single pass. Applies only to newly generated subtitles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidad traduce y luego refina cada línea; Rápida traduce en una sola pasada. Solo se aplica a los subtítulos recién generados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualité traduit puis affine chaque ligne ; Rapide traduit en une seule passe. S'applique uniquement aux sous-titres nouvellement générés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高品質は各行を翻訳してから推敲します。高速は1パスで翻訳します。新しく生成された字幕にのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "품질은 각 줄을 번역한 후 다듬고, 빠름은 한 번에 번역합니다. 새로 생성된 자막에만 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade traduz e depois refina cada linha; Rápida traduz em uma única passagem. Aplica-se apenas a legendas recém-geradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高质量模式先直译再逐行润色；快速模式一次完成翻译。仅适用于新生成的字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高品質模式先直譯再逐行潤飾；快速模式一次完成翻譯。僅適用於新生成的字幕。"
          }
        }
      }
    },
