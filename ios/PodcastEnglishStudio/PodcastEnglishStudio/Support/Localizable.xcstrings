    "settings.assistant_service_help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة المساعد منفصلة عن التوليد السحابي وتستخدم عنوان HTTPS ورمزًا خاصين بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistentendienst ist von der Cloud-Generierung getrennt und nutzt eine eigene HTTPS-Adresse und ein eigenes Token."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant service is separate from cloud generation. It uses its own HTTPS address and token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del asistente es independiente de la generación en la nube. Usa su propia dirección HTTPS y token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’assistant est distinct de la génération cloud. Il utilise sa propre adresse HTTPS et son jeton."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントサービスはクラウド生成とは別です。独自の HTTPS アドレスとトークンを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트 서비스는 클라우드 생성과 별개이며 자체 HTTPS 주소와 토큰을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do assistente é separado da geração na nuvem. Ele usa o próprio endereço HTTPS e token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手服务与云端生成服务相互独立，使用单独的 HTTPS 地址和令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手服務與雲端生成服務相互獨立，使用單獨的 HTTPS 網址和權杖。"
          }
        }
      }
    },
