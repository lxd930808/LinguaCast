    "account.self_hosted_help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم خادم LinguaCast الخاص بك. لا يتم إرسال بيانات تسجيل الدخول الرسمية مطلقًا إلى خادم مستضاف ذاتيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deinen eigenen LinguaCast-Server. Offizielle Anmeldedaten werden niemals an einen selbst gehosteten Server gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own LinguaCast server. Official sign-in credentials are never sent to a self-hosted server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu propio servidor de LinguaCast. Las credenciales de inicio de sesión oficiales nunca se envían a un servidor autoalojado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre propre serveur LinguaCast. Les identifiants de connexion officiels ne sont jamais envoyés à un serveur auto-hébergé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の LinguaCast サーバを使用します。公式のサインイン資格情報がセルフホストサーバに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 LinguaCast 서버를 사용합니다. 공식 로그인 자격 증명은 자체 호스팅 서버로 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use seu próprio servidor LinguaCast. As credenciais de login oficiais nunca são enviadas a um servidor auto-hospedado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 LinguaCast 服务器。官方登录凭据绝不会发送到自托管服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 LinguaCast 伺服器。官方登入憑證絕不會傳送到自架伺服器。"
          }
        }
      }
    },
    "account.self_hosted_token": {
