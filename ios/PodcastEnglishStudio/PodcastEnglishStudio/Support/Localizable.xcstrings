{
  "sourceLanguage": "en",
  "strings": {
    "assistant.v2.transcript.reconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection interrupted. Retrying…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接暂时中断，正在重试…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión interrumpida. Reintentando…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung unterbrochen. Erneuter Versuch…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexão interrompida. Tentando novamente…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が中断されました。再試行しています…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中斷，正在重試…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊겼습니다. 다시 시도하는 중…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال. جارٍ إعادة المحاولة…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion interrompue. Nouvelle tentative…"
          }
        }
      }
    },
    "assistant.v2.transcript.stalled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress has not changed for a while. Still checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度较长时间未更新，仍在检查…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso no ha cambiado en un rato. Comprobando…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt hat sich eine Weile nicht geändert. Wird noch geprüft…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso não mudou por um tempo. Ainda verificando…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく進捗に変化がありません。確認中です…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進度已有一段時間未更新，仍在檢查中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황이 한동안 바뀌지 않았습니다. 계속 확인 중…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتغير التقدم لفترة. لا يزال التحقق جاريًا…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression n'a pas changé depuis un moment. Vérification en cours…"
          }
        }
      }
    },
