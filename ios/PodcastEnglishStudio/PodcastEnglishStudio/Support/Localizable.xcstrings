    "account.error.invalid_token": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم رمز الوصول هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dieses Zugriffstoken abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected this access token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó este token de acceso."
          }
        },
        "fr": {
          "stringUnit": {
