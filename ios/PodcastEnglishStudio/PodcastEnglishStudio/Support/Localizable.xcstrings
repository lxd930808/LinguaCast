    "assistant.v2.transcribe_confirm_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ هذا مهمة تفريغ وترجمة سحابية كاملة. لن يُنزَّل أي وسائط على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird ein vollständiger Cloud-Transkriptions- und Übersetzungsauftrag gestartet. Medien werden nicht auf dieses Gerät heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This starts a full cloud transcription and translation job. It does not download media on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto inicia un trabajo completo de transcripción y traducción en la nube. No descarga medios en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela lance une tâche complète de transcription et de traduction dans le cloud. Aucun média n’est téléchargé sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドの文字起こしと翻訳ジョブを開始します。この端末にメディアはダウンロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 클라우드 전사 및 번역 작업을 시작합니다. 이 기기에는 미디어를 다운로드하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inicia um trabalho completo de transcrição e tradução na nuvem. Não baixa mídia neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会启动完整的云端转写和翻译任务，不会在本机下载媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會啟動完整的雲端轉寫和翻譯任務，不會在本機下載媒體。"
          }
        }
      }
    },
