# LinguaCast self-host settings (V18). Do not edit this file in place:
#   ./init-env.sh selfhost      # single-user deployment token (default)
#   ./init-env.sh apple         # your own Sign in with Apple configuration
# init-env.sh writes .env (mode 600) with fresh random internal secrets. Afterwards
# replace every value that starts with "replace-". Never commit .env.

# --- Mode and public entry --------------------------------------------------
# selfhost: one fixed account; the app connects with SELFHOST_ACCESS_TOKEN.
# apple:    accounts are created by Sign in with Apple against your Apple team.
LINGUACAST_MODE=selfhost
AUTH_MODE=selfhost
ACCOUNT_DOMAIN=account.example.com
CONTENT_DOMAIN=content.example.com
ASSISTANT_DOMAIN=assistant.example.com
MEDIA_DOMAIN=media.example.com
# ACME contact e-mail for public certificates, or "internal" on an isolated test server.
CADDY_TLS=replace-with-admin@example.com

# --- Account service ----------------------------------------------------------
# selfhost mode: the token you enter in the app under Settings > Server.
SELFHOST_ACCESS_TOKEN=replace-generated-by-init-env
ACCOUNT_INTERNAL_TOKENS=content-pipeline:replace-generated,research-assistant:replace-generated,media-service:replace-generated
ACCOUNT_PURGE_TOKEN=replace-generated-by-init-env
# Apple mode only. Put the Sign in with Apple private key at secrets/apple-sign-in-key.p8.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Comma-separated bundle IDs / service IDs allowed as the identity token audience.
APPLE_CLIENT_IDS=
# 32 random bytes, base64 (init-env.sh generates it in apple mode).
APPLE_TOKEN_ENCRYPTION_KEY=
# Daily free limits and concurrency per account (Asia/Shanghai day boundary).
QUOTA_MEDIA_SECONDS_PER_DAY=1800
QUOTA_ASSISTANT_TURNS_PER_DAY=20
QUOTA_MEDIA_CONCURRENCY=1
QUOTA_ASSISTANT_CONCURRENCY=1
CAPABILITY_VIDEO_MEDIA=1

# --- Service identity (generated; keep consistent across services) ------------
# selfhost: every business service uses SELFHOST_ACCESS_TOKEN as its deployment token.
# apple:    services introspect access tokens at the account service and sign account context.
CONTENT_IDENTITY_MODE=selfhost
ASSISTANT_IDENTITY_MODE=selfhost
MEDIA_IDENTITY_MODE=selfhost
CONTENT_SERVICE_TOKEN=replace-generated-by-init-env
ASSISTANT_SERVICE_TOKEN=replace-generated-by-init-env
MEDIA_AUTH_TOKEN=replace-generated-by-init-env
CONTENT_ACCOUNT_TOKEN=
ASSISTANT_ACCOUNT_TOKEN=
MEDIA_ACCOUNT_TOKEN=
CONTENT_INTERNAL_CALLERS=research-assistant:replace-generated,account-service:replace-generated
ASSISTANT_INTERNAL_CALLERS=account-service:replace-generated
MEDIA_INTERNAL_CALLERS=content-pipeline:replace-generated,account-service:replace-generated
ACCOUNT_CONTEXT_SIGNING_KEY=
CONTENT_MEDIA_API_TOKEN=replace-generated-by-init-env
ASSISTANT_CONTENT_TOKEN=replace-generated-by-init-env
MEDIA_URL_SIGNING_KEY=replace-generated-by-init-env

# --- Content pipeline providers -----------------------------------------------
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
# dashscope, openrouter or deepseek. TRANSLATION_MODEL is required for dashscope/openrouter.
TRANSLATION_PROVIDER=deepseek
TRANSLATION_API_KEY=replace-with-your-translation-key
TRANSLATION_MODEL=deepseek-v4-flash
TRANSLATION_REASONING_EFFORT=
CONTENT_GLOBAL_CONCURRENCY=1
CONTENT_ACCOUNT_CONCURRENCY=1

# --- Cloudflare R2 (content artifacts; required) ------------------------------
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret
R2_BUCKET=replace-with-your-bucket
R2_PREFIX=content-pipeline
R2_ENVIRONMENT=prod

# --- Research assistant --------------------------------------------------------
# Model access is configured in pi-config/models.json and pi-config/auth.json.
YOUTUBE_API_KEY=
ASSISTANT_GLOBAL_PI_TURNS=1
ASSISTANT_ACCOUNT_TURNS=1

# --- Media service -------------------------------------------------------------
MEDIA_PREFERRED_HEIGHT=720
MEDIA_MIN_FREE_BYTES=5368709120
# Optional R2 for media playback (leave all four empty to serve from this host).
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_BUCKET=

# --- Pinned tool and image versions ------------------------------------------
YTDLP_VERSION=2026.08.19
# Must match between the media image plugin and the pot-provider image; empty = latest.
BGUTIL_POT_PROVIDER_VERSION=2.0.0
CADDY_VERSION=2.8.4
